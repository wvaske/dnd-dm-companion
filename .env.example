# Copy to .env and fill in. Used by the MCP server, the dmc CLI, and scripts.

# Full URL of the wiki; api.php must be reachable at $MEDIAWIKI_URL/api.php
MEDIAWIKI_URL=https://wiki.deeznuts.wiki

# Bot credentials from Special:BotPasswords (grants: edit + create pages; NOT delete)
BOT_USERNAME=YourUsername@companion
BOT_PASSWORD=changeme

# Set to 1 to block all wiki writes (useful while testing a new harness/model/skill)
DMC_READ_ONLY=0
