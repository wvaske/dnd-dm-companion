# Copy to .env and fill in. Used by the MCP server, the dmc CLI, and scripts.

# Full URL of the wiki; api.php must be reachable at $MEDIAWIKI_URL/api.php
MEDIAWIKI_URL=https://wiki.deeznuts.wiki

# Bot credentials from Special:BotPasswords (grants: edit + create pages; NOT delete)
BOT_USERNAME=YourUsername@companion
BOT_PASSWORD=changeme

# Set to 1 to block all wiki writes (useful while testing a new harness/model/skill)
DMC_READ_ONLY=0

# --- Semantic search (optional) ---------------------------------------------
# Any OpenAI-compatible embeddings endpoint. Examples:
#   Ollama:   EMBEDDINGS_URL=http://localhost:11434/v1  EMBEDDINGS_MODEL=nomic-embed-text
#   LiteLLM:  EMBEDDINGS_URL=http://localhost:4000/v1   EMBEDDINGS_MODEL=<your model>
#   OpenAI:   EMBEDDINGS_URL=https://api.openai.com/v1  EMBEDDINGS_MODEL=text-embedding-3-small
#EMBEDDINGS_URL=
#EMBEDDINGS_MODEL=
#EMBEDDINGS_API_KEY=

# Vector storage backend: sqlite (default, zero infrastructure) or opensearch
# (recommended once you ingest full sourcebooks with `dmc ingest-book`)
#VECTOR_BACKEND=sqlite

# sqlite backend: where the local index lives (derived data, gitignored)
#DMC_INDEX_PATH=lore_index.db

# opensearch backend: the instance already backing CirrusSearch works
#OPENSEARCH_URL=http://localhost:9200
#OPENSEARCH_INDEX=dmc-lore
#OPENSEARCH_USERNAME=
#OPENSEARCH_PASSWORD=

# Wiki namespaces to index, comma-separated ids. 0 = main namespace (campaign
# lore). Add a custom namespace id here to index a DM-only reference section
# (e.g. Sourcebook:) — non-main namespaces count as "official" in scoped search.
#INDEX_NAMESPACES=0
